app.get("/api/user/:id", requireAuth, (req, res) => {
    try {
        const requestedId = Number(req.params.id);

        if (requestedId !== req.session.userId && !getAdmin(req.session.userId)) {
            return res.status(403).json({
                success: false,
                message: "You can only view your own account"
            });
        }

        const user = db.prepare(`
            SELECT
                id,
                name,
                email,
                phone,
                balance,
                virtual_account_number,
                virtual_bank_name,
                kyc_status,
                is_admin,
                purchase_pin,
                created_at
            FROM users
            WHERE id = ?
        `).get(req.params.id);

        if (!user) {
            return res.status(404).json({
                success: false,
                message: "User not found"
            });
        }

        const hasPurchasePin = Boolean(
            user.purchase_pin
        );

        delete user.purchase_pin;

        res.json({
            success: true,
            user: {
                ...user,
                has_purchase_pin: hasPurchasePin
            }
        });

    } catch (error) {
        console.error(
            "User error:",
            error
        );

        res.status(500).json({
            success: false,
            message: "Could not load user"
        });
    }
});


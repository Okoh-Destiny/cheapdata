# Copy this file to .env and fill in real values. Never commit .env itself.

# Port the server listens on (optional — defaults to 3000)
PORT=3000

# Set to "production" when deployed
NODE_ENV=development

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Paystack secret key, used by /api/fund-wallet
PAYSTACK_SECRET_KEY=

# SQLite database location
DB_PATH=./data/cheapdata.db

# WiseSub partner API
WISESUB_BASE_URL=https://app.wisesub.com.ng/api/partner/v1
WISESUB_API_KEY=
WISESUB_API_SECRET=
WISESUB_ENVIRONMENT=test

# Customer price markup over provider cost
CHEAPDATA_MARKUP_PERCENT=2
